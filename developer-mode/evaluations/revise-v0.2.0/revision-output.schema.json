{
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "segments"],
  "properties": {
    "language": {"type": "string", "const": "zh"},
    "segments": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end", "text", "notes"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 30},
          "start": {"type": "number"},
          "end": {"type": "number"},
          "text": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
